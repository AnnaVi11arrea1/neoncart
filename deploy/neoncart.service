# /etc/systemd/system/neoncart.service — Puma web server
[Unit]
Description=Neoncart (Puma)
# The database lives on Neon, so the network must actually be up — not merely
# configured — before Puma boots, or the first connection fails at startup.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anna
WorkingDirectory=/home/anna/neoncart
EnvironmentFile=/home/anna/neoncart/.env
Environment=PORT=3001
ExecStart=/home/anna/.rbenv/shims/bundle exec puma -C config/puma.rb
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
