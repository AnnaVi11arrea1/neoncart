# Neoncart — www.everfluorescent.com
# Install: sudo cp deploy/neoncart.nginx /etc/nginx/sites-available/neoncart
#          sudo ln -s /etc/nginx/sites-available/neoncart /etc/nginx/sites-enabled/
#
# TLS is terminated by Cloudflare; cloudflared connects here over plain HTTP on
# loopback, so there is no certbot/443 block. Because the tunnel is the only way
# in, X-Forwarded-Proto is pinned to https rather than $scheme — otherwise Rails
# would generate http:// URLs and Stripe redirect_urls would be wrong.

upstream neoncart {
  server 127.0.0.1:3001;
  keepalive 8;
}

# The post queue's publisher. The store talks to it over loopback; the only
# reason nginx knows about it is the preview iframe, which a browser has to be
# able to reach. Everything else it serves stays on 127.0.0.1.
upstream publisher {
  server 127.0.0.1:3002;
  keepalive 4;
}

# Apex -> www (single canonical host for SEO, Stripe, and OAuth redirects)
server {
  listen 80;
  server_name everfluorescent.com;
  return 301 https://www.everfluorescent.com$request_uri;
}

server {
  listen 80;
  server_name www.everfluorescent.com;

  root /home/anna/neoncart/public;
  # 20M covered images fine but rejected video uploads outright (nginx 413,
  # which Cloudflare's tunnel then surfaced as a confusing "Worker threw
  # exception" error instead of a clean 413) — raised for the product video
  # upload feature. 150M covers a few minutes of phone-shot product footage;
  # revisit if that's ever not enough.
  client_max_body_size 150M;

  # Real client IP comes from the tunnel, not the loopback peer.
  set $client_ip $remote_addr;
  if ($http_cf_connecting_ip) {
    set $client_ip $http_cf_connecting_ip;
  }

  # Fingerprinted assets — immutable, served straight off disk.
  location ~ ^/(assets|packs)/ {
    expires max;
    add_header Cache-Control "public, immutable";
    access_log off;
    gzip_static on;
    try_files $uri @app;
  }

  # The post-queue preview, framed by /admin/post_queue. It carries its own
  # signature and expiry rather than a bearer token, because an iframe sends no
  # Authorization header — the publisher refuses anything unsigned or stale.
  # Only this one path of the publisher is exposed; the API stays on loopback.
  location = /post-preview {
    proxy_pass http://publisher/preview$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }

  # Active Storage product images proxy through the app (signed URLs).
  location / {
    try_files $uri @app;
  }

  location @app {
    proxy_pass http://neoncart;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;

    # Stripe webhook signature verification needs the raw, unbuffered body.
    proxy_request_buffering off;
  }
}
