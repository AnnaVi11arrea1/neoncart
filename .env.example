# ===== Core =====
SECRET_KEY_BASE=generate_with__bin/rails_secret__or__openssl_rand_-hex_64
APP_HOST=https://shop.everfluorescent.example        # public URL of this store
STORE_NAME=Ever Fluorescent
STORE_EMAIL=shop@everfluorescent.example             # From: address on all emails
ADMIN_EMAIL=you@everfluorescent.example              # gets ticket alerts + seed admin login
ADMIN_PASSWORD=change-me-before-seeding
TIME_ZONE=America/Chicago

# ===== Database (Neon) =====
# Neon dashboard -> your project -> Connection string (pooled works fine)
# If your local Postgres requires password auth, set DATABASE_URL like this:
# DATABASE_URL=postgres://Anna:YOUR_LOCAL_POSTGRES_PASSWORD@127.0.0.1:5432/neoncart_development
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neoncart?sslmode=require

# ===== Stripe =====
# Dashboard -> Developers -> API keys. Webhook secret comes from the
# endpoint you create pointing at https://YOUR_HOST/webhooks/stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sales tax via Stripe Tax. Leave false until you've set this up in
# Stripe Dashboard -> Settings -> Tax (origin address + at least one
# state registration) — enabling this first breaks every checkout.
ENABLE_STRIPE_TAX=false

# ===== Shipping shown at Stripe Checkout =====
SHIP_COUNTRIES=US,CA
FLAT_SHIPPING_CENTS=599

# ===== SMTP (any free-tier SMTP works: Gmail app password, Zoho, Brevo…) =====
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=shop@everfluorescent.example
SMTP_PASSWORD=xxxx

# ===== Partner API (CORS allowlist for browser calls) =====
ALLOWED_ORIGINS=https://festconnect.trickell.digital,https://govend.ing

# ===== Discord order notifications (optional) =====
# Discord: channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy
# Webhook URL. Leave blank to skip Discord notifications entirely.
DISCORD_WEBHOOK_URL=

# ===== Sentry =====
# Dashboard -> ever-fluorescent-llc org -> neoncart project -> Settings -> Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ===== Runtime =====
RAILS_ENV=production
PREVIEW_MODE=0
RAILS_LOG_TO_STDOUT=1
FORCE_SSL=true
GOOD_JOB_MAX_THREADS=3
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=5

# ===== Google login (OmniAuth) =====
# console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized redirect URI: https://YOUR_HOST/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
