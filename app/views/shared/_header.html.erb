<header class="site-header">
  <div class="container site-header__row">
    <%= link_to root_path, class: "brand" do %>
      <%= image_tag "white-logosee-stamp.svg", alt: store_name, class: "brand__logo", width: 122, height: 44 %>
    <% end %>
    <nav class="site-nav">
      <%= nav_link "Shop", products_path %>
      <%= nav_link "Gallery", gallery_path %>
      <%= nav_link "Track order", order_lookup_path %>
      <%= nav_link "Leave a review", verify_reviews_path %>
      <% if preview_mode? %>
        <%= nav_link "Support", new_ticket_path %>
        <span class="hint">Preview mode</span>
      <% else %>
        <%= nav_link "Support", user_signed_in? ? tickets_path : new_ticket_path %>
        <% if user_signed_in? %>
          <%= nav_link "My account", account_path %>
          <% if current_user.admin? %><%= nav_link "Admin", admin_root_path %><% end %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "linklike" %>
        <% else %>
          <%= nav_link "Sign in", new_user_session_path %>
        <% end %>
      <% end %>
      <%= link_to cart_path, class: "cart-link" do %>
        Cart <span class="cart-count"><%= current_cart.item_count %></span>
      <% end %>
    </nav>
  </div>
</header>
