<%# Home page only. `summary` comes from GoogleReviews and is nil when the
    Places API isn't configured or didn't answer; then the saved reviews show. %>
<section class="reviews">
  <div class="container">
    <h2 class="section__title">What people are saying</h2>
    <% if summary&.reviews.present? %>
      <% if summary.rating %>
        <p class="reviews__summary">
          <span class="review-card__stars" aria-hidden="true"><%= "★" * summary.rating.round %><%= "☆" * (5 - summary.rating.round) %></span>
          <strong><%= number_with_precision(summary.rating, precision: 1) %></strong>
          <span>from <%= pluralize(summary.count.to_i, "Google review") %></span>
        </p>
      <% end %>
      <div class="reviews__track">
        <% summary.reviews.each do |review| %>
          <blockquote class="review-card review-card--google">
            <div class="review-card__stars" aria-label="<%= review.rating %> out of 5 stars"><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></div>
            <p class="review-card__text"><%= review.text %></p>
            <footer class="review-card__author">
              <% if review.photo_url %>
                <%= image_tag review.photo_url, alt: "", class: "review-card__avatar", width: 32, height: 32,
                      loading: "lazy", referrerpolicy: "no-referrer" %>
              <% end %>
              <span>
                <%= link_to_if review.author_url, review.author, review.author_url,
                      class: "review-card__name", target: "_blank", rel: "noopener" %>
                <span class="review-card__meta">
                  <%= link_to_if review.url, "Google review", review.url, target: "_blank", rel: "noopener" %><% if review.when %> &middot; <%= review.when %><% end %>
                </span>
              </span>
            </footer>
          </blockquote>
        <% end %>
      </div>
    <% else %>
      <div class="reviews__track">
        <%= render "shared/saved_reviews" %>
      </div>
    <% end %>
    <p class="reviews__cta">
      <%= link_to "See more on Google →", "https://www.google.com/maps/place/Ever+Fluorescent/@41.5523412,-88.2174476,17z/data=!4m8!3m7!1s0x4344efc5dcdb14b9:0x97a2ee0b8b0527cf!8m2!3d41.5523372!4d-88.2148727!9m1!1b1!16s%2Fg%2F11pzpsdhcz",
            target: "_blank", rel: "noopener" %>
      &nbsp;&middot;&nbsp;
      <%= link_to "See more on Facebook →", "https://www.facebook.com/StayFluorescent/reviews/",
            target: "_blank", rel: "noopener" %>
    </p>
  </div>
</section>
