<%= form_with model: [:admin, supplier], class: "stack panel" do |f| %>
  <% if supplier.errors.any? %>
    <div class="flash flash--alert"><%= supplier.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="field-row">
    <label class="field"><span>Name</span><%= f.text_field :name, required: true %></label>
    <label class="field"><span>Adapter</span><%= f.select :adapter, Dropshipping::Registry.options_for_select %></label>
    <label class="field"><span>Fulfillment mode</span><%= f.select :fulfillment_mode, %w[auto manual] %></label>
  </div>
  <div class="field-row">
    <label class="field"><span>API base URL <em class="hint">(blank = adapter default)</em></span><%= f.text_field :api_base_url, class: "mono" %></label>
    <label class="field"><span>API key / token</span><%= f.text_field :api_key, class: "mono" %></label>
    <label class="field"><span>API secret <em class="hint">(if required)</em></span><%= f.text_field :api_secret, class: "mono" %></label>
    <label class="field"><span>Shop ID <em class="hint">(Printify: auto-detected)</em></span><%= f.text_field :shop_id, class: "mono" %></label>
  </div>
  <label class="field"><span>Settings JSON <em class="hint">(endpoint paths / JSON keys — see GenericPodAdapter)</em></span>
    <%= f.text_area :settings_json, value: JSON.pretty_generate(supplier.settings.presence || {}), rows: 6, class: "mono" %></label>
  <label class="check"><%= f.check_box :active %> <span>Active</span></label>
  <%= f.submit "Save supplier", class: "btn btn--primary" %>
<% end %>
