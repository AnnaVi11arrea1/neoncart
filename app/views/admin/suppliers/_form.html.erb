<%= form_with model: [:admin, supplier], class: "stack panel" do |f| %>
  <% if supplier.errors.any? %>
    <div class="flash flash--alert"><%= supplier.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="field-row">
    <label class="field"><span>Name</span><%= f.text_field :name, required: true %></label>
    <label class="field"><span>Adapter</span><%= f.select :adapter, Dropshipping::Registry.options_for_select %></label>
    <label class="field"><span>Fulfillment mode</span><%= f.select :fulfillment_mode, %w[auto manual] %></label>
  </div>
  <div class="field-row">
    <label class="field"><span>API base URL <em class="hint">(blank = adapter default)</em></span><%= f.text_field :api_base_url, class: "mono" %></label>
    <label class="field"><span>API key / token</span><%= f.text_field :api_key, class: "mono" %></label>
    <label class="field"><span>API secret <em class="hint">(if required)</em></span><%= f.text_field :api_secret, class: "mono" %></label>
    <label class="field"><span>Shop ID <em class="hint">(Printify: auto-detected)</em></span><%= f.text_field :shop_id, class: "mono" %></label>
  </div>
  <label class="field"><span>Settings JSON <em class="hint">(endpoint paths / JSON keys — see GenericPodAdapter)</em></span>
    <%= f.text_area :settings_json, value: JSON.pretty_generate(supplier.settings.presence || {}), rows: 6, class: "mono" %></label>
  <label class="check"><%= f.check_box :active %> <span>Active</span></label>
  <%= f.submit "Save supplier", class: "btn btn--primary" %>
<% end %>

<% if supplier.persisted? && supplier.adapter.to_s == "Dropshipping::ArtsAddAdapter" %>
  <div class="stack panel">
    <h2>Import / sync products from ArtsAdd</h2>
    <p class="hint">
      ArtsAdd has no pull API, so products are imported from your seller-center
      export. In ArtsAdd → <strong>Seller Center → Products → Export</strong>,
      download the <span class="mono">.xls</span> file and upload it here.
      Re-upload a fresh export any time to <strong>pull in your changes</strong>:
      existing products update in place, new ones are added as drafts to review,
      and sizes you removed on ArtsAdd become unavailable.
    </p>
    <%= form_with url: import_admin_supplier_path(supplier), method: :post, multipart: true, class: "field-row" do |f| %>
      <label class="field">
        <span>ArtsAdd export file <em class="hint">(.xls)</em></span>
        <%= f.file_field :file, accept: ".xls,.xml,application/xml,text/xml", required: true %>
      </label>
      <label class="field">
        <span>
          <%= check_box_tag :activate_all, "1", true %>
          Activate all listings after import
        </span>
        <em class="hint">
          Puts every non-archived product live and every size back in stock,
          including ArtsAdd items still in <strong>Saved</strong> status, which
          otherwise import as sold out. Untick to review new items as drafts.
        </em>
      </label>
      <%= f.submit "Import / Sync now", class: "btn btn--primary" %>
    <% end %>
    <% if supplier.last_sync_log.present? %>
      <p class="hint">Last import: <%= supplier.last_sync_log %></p>
    <% end %>
  </div>
<% end %>
