<!DOCTYPE html>
<html lang="en" data-theme="uv">
  <head>
    <%# No analytics tag here on purpose: admin sessions are Anna's own and,
        at this store's traffic, they visibly skew the storefront reports. %>
    <title><%= content_for(:title) || "Admin" %> · <%= store_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "admin" %>
  </head>

  <body class="admin-body">
    <div class="uv-tube" aria-hidden="true"></div>
    <div class="admin-shell">
      <aside class="admin-nav">
        <p class="admin-brand"><%= link_to store_name, root_path %><span class="admin-brand__tag">console</span></p>
        <nav>
          <%= nav_link "Dashboard", admin_root_path %>
          <%= nav_link "Orders", admin_orders_path %>
          <%= nav_link "Terminal (POS)", admin_terminal_path %>
          <%= nav_link "Fulfillment queue", admin_fulfillments_path %>
          <%= nav_link "Products", admin_products_path %>
          <%= nav_link "Gallery", admin_paintings_path %>
          <%= nav_link "Tickets", admin_tickets_path %>
          <%= nav_link "Reviews", admin_reviews_path %>
          <%= nav_link "Post queue", admin_post_queue_path %>
          <%= nav_link "Retro post search", admin_published_posts_path %>
          <%= nav_link "Suppliers", admin_suppliers_path %>
          <%= nav_link "API keys", admin_api_keys_path %>
          <%= nav_link "Webhooks", admin_webhook_endpoints_path %>
          <%= nav_link "API docs", admin_docs_path %>
          <%= nav_link "Job queue", admin_good_job_path %>
        </nav>
        <div class="admin-nav__foot btn-row">
          <%= link_to "← Back to store", root_path, class: "btn btn--ghost btn--sm" %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
        </div>
      </aside>
      <div class="admin-main">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
