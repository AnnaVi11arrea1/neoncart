<% content_for :title, "Cart · #{store_name}" %>
<% unless preview_mode? || @cart.empty? %>
  <%= ga_event("view_cart", ga_cart_payload(@cart, @items)) %>
<% end %>
<h1>Your cart</h1>

<% if @cart.empty? %>
  <div class="empty">
    <p>Your cart is empty — it's dark in here (which is fitting, honestly).</p>
    <%= link_to "Browse the shop", products_path, class: "btn btn--primary" %>
  </div>
<% else %>
  <div class="cart">
    <table class="table">
      <thead><tr><th>Item</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr></thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td>
              <div class="cart__item">
                <% if (url = item.product.primary_image_url) %><img src="<%= url %>" alt="<%= item.product.primary_image_alt %>"><% end %>
                <%= link_to item.display_title, product_path(item.product.slug) %>
              </div>
            </td>
            <td class="mono"><%= format_money(item.unit_price_cents) %></td>
            <td>
              <%= form_with url: cart_item_path(item), method: :patch, class: "qty-form" do |f| %>
                <%= f.number_field :quantity, name: "cart_item[quantity]", value: item.quantity, min: 0, max: 99, onchange: "this.form.requestSubmit()", "aria-label": "Quantity" %>
              <% end %>
            </td>
            <td class="mono"><%= format_money(item.line_total_cents) %></td>
            <td><%= button_to "✕", cart_item_path(item), method: :delete, class: "linklike", "aria-label": "Remove #{item.display_title}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="cart__summary">
      <p class="cart__subtotal">Subtotal <strong class="mono"><%= format_money(@cart.subtotal_cents) %></strong></p>
      <p class="hint">Shipping and tax calculated at checkout. Pay by card, Google Pay, or Apple Pay.</p>

      <% unless user_signed_in? %>
        <div class="cart__signup-nudge">
          <p><strong>Get $5 off this order</strong> — create a free account, takes two seconds.</p>
          <%= button_to "Continue with Google", user_google_oauth2_omniauth_authorize_path(origin: cart_path),
                data: { turbo: false }, class: "btn btn--oauth" %>
          <p class="hint"><%= link_to "or sign up with email", new_user_registration_path %></p>
        </div>
      <% end %>

      <% if user_signed_in? && current_user.store_credit_cents.positive? %>
        <label class="check">
          <%= check_box_tag "apply_credit", "1", true, form: "checkout-form" %>
          Apply <%= format_money([current_user.store_credit_cents, @cart.subtotal_cents].min) %> store credit
        </label>
      <% end %>
      <%= form_with url: checkout_path, method: :post, html: { id: "checkout-form", data: { turbo: false } } do %>
        <%= submit_tag "Checkout →", class: "btn btn--primary btn--lg btn--wide" %>
      <% end %>
      <%# begin_checkout fires on submit rather than on cart view, so it counts
          intent to pay and not just window shopping. gtag uses sendBeacon, so
          it still goes out as the browser leaves for Stripe. %>
      <% unless preview_mode? %>
        <script>
          document.getElementById('checkout-form').addEventListener('submit', function () {
            gtag('event', 'begin_checkout', <%== ga_json(ga_cart_payload(@cart, @items)) %>);
          }, { once: true });
        </script>
      <% end %>
    </div>
  </div>
<% end %>
