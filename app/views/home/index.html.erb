<% content_for :title, "#{store_name} · UV-Reactive Festival Wear by Anna Villarreal" %>
<% content_for :description, "Original blacklight-reactive festival wear by independent artist Anna Villarreal — UV-reactive apparel, prints, and accessories for raves and music festivals. Every design is painted, processed, and shipped by the artist." %>
<% content_for :structured_data do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Store",
    "name" => store_name,
    "description" => page_description,
    "url" => root_url,
    "image" => "#{request.base_url}/apple-touch-icon.png",
    "founder" => { "@type" => "Person", "name" => "Anna Villarreal" },
    "email" => Rails.configuration.x.store_email,
    "currenciesAccepted" => "USD",
    "paymentAccepted" => "Credit Card, Apple Pay, Google Pay"
  }) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "WebSite",
    "name" => store_name,
    "url" => root_url,
    "potentialAction" => {
      "@type" => "SearchAction",
      "target" => { "@type" => "EntryPoint", "urlTemplate" => "#{products_url}?q={search_term_string}" },
      "query-input" => "required name=search_term_string"
    }
  }) %>
<% end %>
<section class="hero">
  <%= image_tag "uv-reactive-blacklight-festival-portrait-art.jpg",
        alt: "UV-reactive blacklight portrait art by Ever Fluorescent — glowing face paint inspiration for festival wear",
        class: "hero__image", width: 480, height: 480 %>
  <h1 class="hero__title">Wearable art<br>by Anna Villarreal.</h1>
  <p class="hero__sub">UV-reactive apparel, prints, and accessories designed for music festivals and blacklight nights. Thank you for supporting an independent artist — every design is painted, processed, and shipped by me. &lt;3</p>
  <div class="hero__actions">
    <%= link_to "Shop the collection", products_path, class: "btn btn--primary btn--lg" %>
    <%= link_to "Track an order", order_lookup_path, class: "btn btn--ghost btn--lg" %>
  </div>
</section>

<% if @featured.any? %>
  <section class="section">
    <h2 class="section__title">Featured</h2>
    <div class="product-grid">
      <% @featured.each do |product| %>
        <%= render "shared/product_card", product: product %>
      <% end %>
    </div>
  </section>
<% end %>

<section class="section">
  <h2 class="section__title">Latest drops</h2>
  <% if @latest.any? %>
    <div class="product-grid">
      <% @latest.each do |product| %>
        <%= render "shared/product_card", product: product %>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p>No products yet. Head to <strong>Admin → Suppliers → Sync</strong> to pull your catalog, or add one manually under <strong>Admin → Products</strong>.</p>
    </div>
  <% end %>
</section>
