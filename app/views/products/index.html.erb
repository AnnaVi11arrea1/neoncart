<% content_for :title, "Shop · #{store_name}" %>
<% content_for :description, "Shop UV-reactive tees, board shorts, sweatpants, and hoodies featuring original blacklight artwork by Anna Villarreal." %>
<%# filters/search produce duplicate listings, so they all canonicalise to /products %>
<% content_for :canonical, products_url %>
<div class="page-head">
  <h1>Shop</h1>
  <%= form_with url: products_path, method: :get, class: "searchbar" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "Search the glow…", "aria-label": "Search products" %>
    <% if @categories.any? %>
      <%= f.select :category,
            options_for_select([["All categories", ""]] + @categories.map { |c| [c.name, c.slug] }, params[:category]),
            {}, "aria-label": "Filter by category", onchange: "this.form.requestSubmit()" %>
    <% end %>
    <%= f.submit "Search", class: "btn btn--sm" %>
  <% end %>
</div>

<% if @products.any? %>
  <div class="product-grid">
    <% @products.each do |product| %>
      <%= render "shared/product_card", product: product %>
    <% end %>
  </div>
  <% if @pagy %><%= render "shared/pagination", pagy: @pagy %><% end %>
<% else %>
  <div class="empty"><p>Nothing matches<%= " “#{params[:q]}”" if params[:q].present? %>. Try another search.</p></div>
<% end %>
