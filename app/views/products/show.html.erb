<% product_description_text = @product.description.is_a?(ActionText::RichText) ? @product.description.to_plain_text : @product.description.to_s %>
<% content_for :title, "#{@product.title} · #{store_name}" %>
<% content_for :description, product_description_text.presence || "#{@product.title} — UV-reactive artwork by Anna Villarreal, printed to order and shipped from an independent studio." %>
<% content_for :og_type, "product" %>
<% if (og = @product.all_image_urls.first).present? %><% content_for :og_image, absolute_image_url(og) %><% end %>
<% content_for :structured_data do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Product",
    "name" => @product.title,
    "description" => page_description,
    "image" => @product.all_image_urls.first(5).map { |u| absolute_image_url(u) },
    "sku" => @product.external_id,
    "brand" => { "@type" => "Brand", "name" => store_name },
    "category" => @product.category&.name,
    "offers" => {
      "@type" => "Offer",
      "url" => product_url(@product),
      "priceCurrency" => @product.currency.to_s.upcase,
      "price" => (@product.price_cents / 100.0).to_s,
      "availability" => @sold_out ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
      "itemCondition" => "https://schema.org/NewCondition",
      "seller" => { "@type" => "Organization", "name" => store_name }
    }
  }.compact) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => "Shop", "item" => products_url },
      { "@type" => "ListItem", "position" => 2, "name" => @product.title, "item" => product_url(@product) }
    ]
  }) %>
<% end %>
<article class="product-page">
  <div class="product-page__gallery">
    <% gallery = @product.respond_to?(:gallery_images) ? @product.gallery_images : @product.all_image_urls.map { |u| { url: u, alt: @product.title } } %>
    <% if gallery.any? %>
      <div class="product-page__main-wrap" data-controller="gallery">
        <% if gallery.size > 1 %>
          <button type="button" class="gallery-arrow gallery-arrow--prev" data-action="gallery#prev" aria-label="Previous image">‹</button>
        <% end %>
        <img class="product-page__main" data-gallery-target="main" src="<%= gallery.first[:url] %>" alt="<%= gallery.first[:alt] %>">
        <% if gallery.size > 1 %>
          <button type="button" class="gallery-arrow gallery-arrow--next" data-action="gallery#next" aria-label="Next image">›</button>
        <% end %>
        <% if gallery.size > 1 %>
          <div class="product-page__thumbs">
            <% gallery.each_with_index do |img, i| %>
              <button type="button" class="product-page__thumb <%= "is-active" if i.zero? %>"
                      data-gallery-target="thumb" data-action="gallery#select" data-gallery-index-param="<%= i %>"
                      data-url="<%= img[:url] %>" data-alt="<%= img[:alt] %>" aria-label="Show image <%= i + 1 %>">
                <img src="<%= img[:url] %>" alt="<%= img[:alt] %>" loading="lazy">
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="product-card__placeholder product-page__main">◈</div>
    <% end %>
  </div>

  <div class="product-page__info">
    <% if @product.category %><p class="eyebrow"><%= @product.category.name %></p><% end %>
    <h1><%= @product.title %></h1>
    <p class="product-page__price"><%= format_money(@product.price_cents) %></p>

    <% if preview_mode? %>
      <p class="hint">Preview mode: checkout is disabled until a database is configured.</p>
    <% else %>
      <% if @sold_out %>
        <p class="sold-out">Sold out</p>
        <p class="hint">This one is between print runs — check back soon.</p>
      <% else %>
        <%= form_with url: cart_items_path, method: :post, class: "buy-form" do |f| %>
          <%= f.hidden_field :product_id, value: @product.id %>
          <% if @variants.any? %>
            <label class="field">
              <span><%= variant_option_label(@variants) %></span>
              <%= f.select :variant_id, @variants.map { |v| ["#{v.label} — #{format_money(v.price_cents_or_default)}", v.id] } %>
            </label>
          <% end %>
          <label class="field field--qty">
            <span>Qty</span>
            <%= f.number_field :quantity, value: 1, min: 1, max: 99 %>
          </label>
          <%= f.submit "Add to cart", class: "btn btn--primary btn--lg" %>
        <% end %>
      <% end %>
    <% end %>

    <% if @product.description.is_a?(ActionText::RichText) %>
      <% if @product.description? %>
        <div class="product-page__desc"><%= @product.description %></div>
      <% end %>
    <% elsif @product.description.present? %>
      <div class="product-page__desc"><%= simple_format(@product.description) %></div>
    <% end %>

    <% if @product.tags.any? %>
      <p class="tag-row"><% @product.tags.each do |t| %><span class="tag"><%= t %></span><% end %></p>
    <% end %>
  </div>
</article>

<% if @related.any? %>
  <section class="section">
    <h2 class="section__title">Also glowing</h2>
    <div class="product-grid">
      <% @related.each do |product| %><%= render "shared/product_card", product: product %><% end %>
    </div>
  </section>
<% end %>
