<p style="margin:0 0 12px;font-size:16px;color:#e8e3f6;">New support message</p>
<p style="margin:0 0 8px;font-size:14px;color:#8d83ad;">From <%= @ticket.email %> · <%= @ticket.subject %><% if @ticket.order %> · order <%= @ticket.order.number %><% end %></p>
<div style="margin:0 0 20px;padding:14px 16px;background:#0a0514;border:1px solid #2c1c52;border-radius:8px;font-size:14px;color:#e8e3f6;line-height:1.6;"><%= simple_format(@message.body, {}, sanitize: true) %></div>
<p style="margin:0;"><a href="<%= Rails.configuration.x.store_url %>/admin/tickets/<%= @ticket.token %>" style="display:inline-block;background:#2ee6ff;color:#0a0514;text-decoration:none;padding:11px 22px;border-radius:6px;font-weight:bold;font-size:14px;">Open in console →</a></p>
