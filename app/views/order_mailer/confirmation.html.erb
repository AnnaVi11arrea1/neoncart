<p style="margin:0 0 12px;font-size:16px;color:#e8e3f6;">Thanks for your order, <%= @order.customer_name %>!</p>
<p style="margin:0 0 20px;font-size:14px;color:#8d83ad;">Order <strong style="color:#2ee6ff;font-family:monospace;"><%= @order.number %></strong> is confirmed and heading into production.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <% @order.order_items.each do |item| %>
    <tr>
      <td style="padding:8px 0;border-bottom:1px solid #2c1c52;font-size:14px;color:#e8e3f6;"><%= item.title %> × <%= item.quantity %></td>
      <td style="padding:8px 0;border-bottom:1px solid #2c1c52;font-size:14px;color:#e8e3f6;text-align:right;font-family:monospace;">$<%= format('%.2f', item.line_total_cents / 100.0) %></td>
    </tr>
  <% end %>
  <tr>
    <td style="padding:12px 0;font-size:15px;color:#b6ff3c;font-weight:bold;">Total</td>
    <td style="padding:12px 0;font-size:15px;color:#b6ff3c;font-weight:bold;text-align:right;font-family:monospace;">$<%= format('%.2f', @order.total_cents / 100.0) %></td>
  </tr>
</table>

<p style="margin:24px 0 0;"><a href="<%= Rails.configuration.x.store_url %>/orders/<%= @order.number %>" style="display:inline-block;background:linear-gradient(90deg,#8b3dff,#ff2ea6);color:#fff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:bold;font-size:14px;">Track your order →</a></p>
<p style="margin:16px 0 0;font-size:13px;color:#8d83ad;">We'll email you again the moment it ships, with tracking.</p>
