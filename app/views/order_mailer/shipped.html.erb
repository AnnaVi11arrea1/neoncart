<p style="margin:0 0 12px;font-size:16px;color:#e8e3f6;">Your order is on its way! 🚀</p>
<p style="margin:0 0 20px;font-size:14px;color:#8d83ad;">Order <strong style="color:#2ee6ff;font-family:monospace;"><%= @order.number %></strong> has shipped.</p>

<% @shipments.each do |s| %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 12px;background:#0a0514;border:1px solid #2c1c52;border-radius:8px;">
    <tr><td style="padding:14px 16px;">
      <p style="margin:0 0 4px;font-size:13px;color:#8d83ad;"><%= s.display_carrier %></p>
      <p style="margin:0 0 10px;font-size:15px;color:#e8e3f6;font-family:monospace;"><%= s.tracking_number %></p>
      <% if s.tracking_url %>
        <a href="<%= s.tracking_url %>" style="display:inline-block;background:#2ee6ff;color:#0a0514;text-decoration:none;padding:9px 18px;border-radius:6px;font-weight:bold;font-size:13px;">Track package →</a>
      <% end %>
    </td></tr>
  </table>
<% end %>

<p style="margin:16px 0 0;font-size:13px;color:#8d83ad;">Full order details: <a href="<%= Rails.configuration.x.store_url %>/orders/<%= @order.number %>" style="color:#2ee6ff;"><%= @order.number %></a></p>
