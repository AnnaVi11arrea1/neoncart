<% content_for :title, "Create account · #{store_name}" %>
<div class="narrow">
  <h1>Create account</h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "stack" }) do |f| %>
    <% if resource.errors.any? %>
      <div class="flash flash--alert"><%= resource.errors.full_messages.to_sentence %></div>
    <% end %>
    <label class="field"><span>Name</span><%= f.text_field :name %></label>
    <label class="field"><span>Email</span><%= f.email_field :email, autocomplete: "email" %></label>
    <label class="field"><span>Password <em class="hint">(8+ characters)</em></span><%= f.password_field :password, autocomplete: "new-password" %></label>
    <label class="field"><span>Confirm password</span><%= f.password_field :password_confirmation, autocomplete: "new-password" %></label>
    <%= f.submit "Create account", class: "btn btn--primary" %>
  <% end %>
  <p class="hint">Already registered? <%= link_to "Sign in", new_session_path(resource_name) %></p>
</div>
