<% content_for :title, "Reset password · #{store_name}" %>
<div class="narrow">
  <h1>Reset password</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "stack" }) do |f| %>
    <label class="field"><span>Email</span><%= f.email_field :email, autofocus: true, autocomplete: "email" %></label>
    <%= f.submit "Send reset instructions", class: "btn btn--primary" %>
  <% end %>
  <p class="hint"><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
</div>
