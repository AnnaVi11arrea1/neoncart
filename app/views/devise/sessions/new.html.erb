<% content_for :title, "Sign in · #{store_name}" %>
<div class="narrow">
  <h1>Sign in</h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "stack" }) do |f| %>
    <label class="field"><span>Email</span><%= f.email_field :email, autofocus: true, autocomplete: "email" %></label>
    <label class="field"><span>Password</span><%= f.password_field :password, autocomplete: "current-password" %></label>
    <label class="check"><%= f.check_box :remember_me %> <span>Remember me</span></label>
    <%= f.submit "Sign in", class: "btn btn--primary" %>
  <% end %>
  <div class="oauth-divider"><span>or</span></div>
  <%= button_to "Continue with Google", user_google_oauth2_omniauth_authorize_path,
        data: { turbo: false }, class: "btn btn--oauth" %>
  <p class="hint"><%= link_to "Create an account", new_registration_path(resource_name) %> · <%= link_to "Forgot password?", new_password_path(resource_name) %></p>
</div>
